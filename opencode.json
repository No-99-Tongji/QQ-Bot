{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-chat": { "name": "DeepSeek V4" },
        "deepseek-flash": { "name": "DeepSeek Flash" }
      }
    }
  },
  "permission": {
    "bash": "deny",
    "read": "deny",
    "write": "deny",
    "edit": "deny",
    "glob": "deny",
    "grep": "deny",
    "ls": "deny",
    "webfetch": "deny"
  },
  "mcp": {
    "qq-bot": {
      "type": "local",
      "command": [".venv/bin/python", "opencode/mcp_server.py"],
      "environment": {},
      "enabled": true
    }
  }
}
